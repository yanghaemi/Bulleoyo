# B204 환경변수 계약 — 이름이 정본이다. 값은 절대 커밋하지 않는다(예외: 공개 주소 OPERATOR_ADDRESS·MINTER_ADDRESS).
#
# 이 파일 형식 그대로 값을 채워 Jenkins Secret file `B204_ENV`로 올린다. `IMAGE_TAG`·`CONTRACT_*`·`ALERT_WEBHOOK_URL` 네 줄은 비워 두거나 지워도 된다(파이프라인이 덧붙인다).
# 값은 따옴표 없이 그대로 적는다(`DB_URL` 처럼 &·? 가 들어가도 감싸지 않는다).
#
# 서버(~/app/.env): Jenkins deploy 스테이지가 `B204_ENV` 내용에 위 네 줄을 붙여 자동 생성한다. 손으로 만들지 않는다.
# 로컬: 이 파일을 .env 로 복사해 값을 채운다(.gitignore에 걸려 커밋되지 않는다).
#   cp .env.example .env
#
# 변수 이름을 바꾸면 backend·frontend·docker-compose.yml·Jenkinsfile 네 곳을 함께 고쳐야 한다.

# ---- 배포 ----
# 이미지 태그 = 커밋 SHA 앞 8자리(git rev-parse --short=8 HEAD). 롤백은 이 값을 이전 SHA로 바꿔 다시 up.
IMAGE_TAG=

# ---- MySQL 컨테이너 ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=b204
MYSQL_USER=b204
MYSQL_PASSWORD=

# ---- backend ----
SPRING_PROFILES_ACTIVE=prod
# 응답에 담는 절대 URL(검증 페이지·검표 링크)의 베이스 — 실제 배포 도메인이다.
# application.yml 기본값은 명세 예시 도메인(b204.ssafy.io)이라 반드시 이 값으로 덮는다.
APP_BASE_URL=https://j15b204.p.ssafy.io
DB_URL=jdbc:mysql://mysql:3306/b204?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=b204
DB_PASSWORD=
JWT_SECRET=
# 업로드 파일(포스터) 저장 루트 — **컨테이너 안 경로**다. 호스트 ~/app/uploads 가 여기에 바인드된다
# (docker-compose.yml backend.volumes). 공개 URL 은 위 APP_BASE_URL + /uploads/... 로 조립된다.
# 바꾸려면 compose 의 마운트 오른쪽·호스트 Nginx alias 와 함께 바꾼다. 비워 두면 /app/uploads.
UPLOAD_DIR=/app/uploads
REDIS_HOST=redis
REDIS_PORT=6379

# 운영 지갑 개인키 (0x 포함 66자). B204_ENV 에 반드시 있어야 한다.
OPERATOR_PRIVATE_KEY=
MINTER_PRIVATE_KEY=

# ADMIN_PRIVATE_KEY (콜드 키, 두 컨트랙트 배포자·pause·rotate 전용)는 이 파일과 서버 .env에 넣지 않는다.
# Jenkins Credentials Secret text `ADMIN_PRIVATE_KEY` 로만 등록하고 Deploy contract 스테이지가 읽는다.
# 로컬에서 hardhat 배포 시에만 셸 환경변수로: export ADMIN_PRIVATE_KEY=0x...
# admin ≠ OPERATOR ≠ MINTER 세 주소가 달라야 배포된다(RevenueSplitter RoleConflict).

# 운영 지갑 주소(공개값, 위 개인키의 주소). 이 파일의 값이 정본이다 — 이 파일에서 유일하게 값을 커밋하는 줄.
# Deploy contract 스테이지가 체크아웃의 이 파일에서 읽어 export 하고, deploy.ts 가 생성자 인자로 쓴다.
# 지갑을 바꾸면 여기 주소와 B204_ENV 의 개인키를 같이 바꾼다.
# OPERATOR_ADDRESS 는 API v6 §0.4 prepare 응답의 signRequests[].feePayer 로 나가는 유일한 서버 주소이기도 하다
# (비면 그 필드가 통째로 빠진다). 출처는 blockchain/deployments/kairos.json 의 roles.operator·roles.minter 이고,
# CONTRACT_* 처럼 파이프라인이 자동으로 채우지 않는다 — 개인키와 짝이 맞는지는 사람만 안다.
OPERATOR_ADDRESS=0xfbB324CC674dD2FF21Dff670404391e78F4a199f

# 이 인스턴스의 체인 작업 식별자(blue/green). **여기서 정하지 않는다** — docker-compose.yml 이 색별
# 서비스(backend-blue·backend-green)에 리터럴로 박는다. .env 에 적어도 덮이지 않으니 줄을 만들지 말 것.
# 비어 있으면 언제나 일하는 단일 인스턴스 동작이다(ChainOwnership, S15P21B204-95).
# B204_CHAIN_INSTANCE_ID=  (compose 가 정한다)

# 블루/그린이 남기는 값. 배포 스크립트(exec/deploy/blue-green.sh)가 서버 .env 에 쓰고 Jenkins 가 다음
# 배포 때 살려 둔다 — 여기(B204_ENV)에는 넣지 않는다. 값이 없으면 그 색은 만들지 않는다(:missing).
# BLUE_TAG=<그 색이 돌고 있는 커밋 sha>
# GREEN_TAG=<그 색이 돌고 있는 커밋 sha>
# 백엔드 컨테이너 메모리 상한(기본 3g). 두 색이 같이 뜨므로 호스트 여유를 보고 정한다(exec/README.md).
# BACKEND_MEM_LIMIT=3g
MINTER_ADDRESS=0xDFf6220506315FBd71b104C8693e9b458EB8d0a7

# chain_job 워커 스위치. 줄이 없으면 true(워커가 돈다). MINTER 로테이션 동안만 B204_ENV 에 false 로 넣고,
# 로테이션이 끝나면 그 줄을 지운다(exec/README.md "MINTER 로테이션").
# 빈 값(`CHAIN_WORKER_ENABLED=`)으로 두지 않는다 — compose 는 true 로 바꿔 주지만, 로컬에서 export 해 bootRun 하면
# Spring 이 빈 문자열을 설정값으로 봐 워커가 조용히 꺼진다. 그래서 여기서는 주석으로만 남긴다.
# CHAIN_WORKER_ENABLED=false

KAIA_RPC_URL=https://public-en-kairos.node.kaia.io
KAIA_CHAIN_ID=1001

# blockchain/deployments/kairos.json 에서 CI가 채운다. 파일이 없으면 빈 값.
CONTRACT_YOYO_ADDRESS=
CONTRACT_SPLITTER_ADDRESS=

WEB3AUTH_CLIENT_ID=
# WEB3AUTH_JWKS_URI·WEB3AUTH_ISSUER 는 application.yml 의 기본값(공개 Web3Auth 엔드포인트)을 쓴다.
# 바꿔야 하면 이 파일과 docker-compose.yml 의 backend environment 에 함께 추가한다.

# 정산 공유 링크 베이스 URL(API v6 §11). 서버 기본값이 실제 도메인이라 B204_ENV 에 안 넣어도 된다. 라우트 경로 확정 시 갱신.
SETTLEMENT_SHARE_BASE_URL=https://j15b204.p.ssafy.io/settlement/share

# 정산 이의제기 기간(ISO-8601 Duration). 비우면 48h.
# 리허설·시연에서 release 를 기다릴 수 없을 때만 줄인다 — 예: PT1M
SETTLEMENT_DISPUTE_PERIOD=

# 패스키 본인 확인(API v7 §7.W) — 결제·규칙 동의·보증금·정산 조기 동의·정산금 지급 다섯 동작에 한 스위치. 기본 꺼짐 — false 면 기존 흐름과 같다.
# 빈 값(`STEP_UP_ENABLED=`)으로 두지 않는다 — compose 는 false 로 바꿔 주지만 로컬 export 는 빈 문자열이 된다.
# 켤 때는 세 줄을 함께: WEBAUTHN_RP_ID 는 브라우저로 여는 도메인(예: j15b204.p.ssafy.io),
# WEBAUTHN_ORIGINS 는 그 페이지의 정확한 origin(예: https://j15b204.p.ssafy.io, 쉼표로 여러 개).
STEP_UP_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173

# 운영 알림(서버 결함 revert·발행량 halt 전환) Mattermost incoming webhook — 비밀 값. B204_ENV 에 넣지 않는다.
# 서버는 Jenkins 가 Secret text `MATTERMOST_WEBHOOK`(배포 알림과 같은 채널)으로 채운다. 로컬은 비워 둔다(알림은 로그만).
ALERT_WEBHOOK_URL=

# ---- frontend (빌드 시점 ARG — docker build --build-arg 로 전달된다) ----
# 런타임 .env가 아니다. 값을 바꾸려면 이미지를 다시 빌드해야 한다.
VITE_API_BASE_URL=/api
VITE_WEB3AUTH_CLIENT_ID=
VITE_KAIA_RPC_URL=https://public-en-kairos.node.kaia.io
VITE_KAIA_CHAIN_ID=1001
VITE_CONTRACT_YOYO_ADDRESS=
VITE_CONTRACT_SPLITTER_ADDRESS=
